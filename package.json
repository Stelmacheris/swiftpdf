{
  "name": "swiftpdf",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "lint": "prettier --check src index.html vite.config.ts svelte.config.js .eslintrc.cjs .prettierrc.json tsconfig.json package.json && eslint src vite.config.ts svelte.config.js .eslintrc.cjs --ext .ts,.js,.cjs,.svelte --max-warnings 0",
    "format": "prettier --write src index.html vite.config.ts svelte.config.js .eslintrc.cjs .prettierrc.json tsconfig.json package.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "18.19.130",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-svelte": "2.46.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svelte-eslint-parser": "0.43.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
